<script>function cancelOrder(orderId) {
    $.ajax({
        url: "/cancelOrder",
        method: "POST",
        data: {
            id: orderId
        },
        success: function(response) {
            console.log("Response from server:", response);
            if (response && response.status === true) {
                // Show success message with SweetAlert
                Swal.fire({
                    icon: "success",
                    title: "Order Canceled!",
                    text: "Your order has been successfully canceled.",
                    confirmButtonColor: "#3085d6",
                    confirmButtonText: "OK"
                }).then(function(result) {
                    // If the user clicks OK, reload the page
                    if (result.isConfirmed) {
                        window.location.reload();
                    }
                });
            } else {
                // Handle server error or cancellation failure
                console.error("Failed to cancel order.");
                Swal.fire({
                    icon: "error",
                    title: "Error!",
                    text: "Failed to cancel order. Please try again later.",
                    confirmButtonColor: "#3085d6",
                    confirmButtonText: "OK"
                });
            }
        },
        error: function(xhr, status, error) {
            // Handle AJAX error
            console.error("AJAX error:", error);
            // Show an error message to the user
            Swal.fire({
                icon: "error",
                title: "AJAX Error!",
                text: "Failed to send cancellation request. Please try again later.",
                confirmButtonColor: "#3085d6",
                confirmButtonText: "OK"
            });
        }
    });
}

</script>

